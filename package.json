{
  "name": "wallpaper-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build",
    "preview": "vp preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "check": "vp check && vue-tsc --noEmit",
    "format": "vp fmt"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "npm@11.20.0"
}
